<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <link rel="stylesheet" href="../css/bootstrap.min.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />

</head>

<body>
    <!-- <div class="navbar navbar-inverse navbar-fixed-top"> -->
            <%- include("../partials/header-adm") -%>

    <div class="container body-content">
        <h2>Novo cliente</h2>

        <% const errorsList = errors || []; const data = formData || {}; %>

        <% if (errorsList.length > 0) { %>
            <div class="alert alert-danger">
                <strong>Corrija os campos abaixo:</strong>
                <ul>
                    <% errorsList.forEach(error => { %>
                        <li><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <% if (typeof sucesso !== "undefined" && sucesso) { %>
            <div class="alert alert-success"><%= sucesso %></div>
        <% } %>

        <form action="/adm/adm-cliente-novo" method="post">

              <%- include("../partials/form-cliente") -%>
        </form>

        <div>
            <a class="btn btn-primary btn-lg" href="/adm/adm-cliente" role="button">voltar</a>

        </div>

        <hr />
            <%- include("../partials/footer-adm") -%>
    </div>
</body>

</html>